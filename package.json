{
  "name": "playwright-bdd-allure",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
"scripts": {
  "test": "cucumber-js --config src/config/cucumber.js",

  "test:smoke": "cucumber-js --config src/config/cucumber.js --tags @smoke",
  "test:regression": "cucumber-js --config src/config/cucumber.js --tags @regression",

  "test:cartAdd": "cucumber-js --config src/config/cucumber.js --tags @cartAdd",
  "test:cartRemove": "cucumber-js --config src/config/cucumber.js --tags @cartRemove",

  "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
  "allure:open": "allure open ./allure-report",

  "report": "npm run test && npm run allure:generate && npm run allure:open"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.38.1",
    "allure-cucumberjs": "^3.7.1",
    "playwright": "^1.59.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
